# gis-research credentials — EXAMPLE FILE (safe to commit; contains no real secrets)
#
# Setup:
#   1. cp gis-research/example.env ~/.config/gis-research.env
#   2. Edit ~/.config/gis-research.env with real values
#   3. chmod 600 ~/.config/gis-research.env
#
# NEVER put real values in this file or anywhere inside the repo.

# Copernicus Data Space Ecosystem (https://dataspace.copernicus.eu) account.
# Used by research_tools/cdse.py for Sentinel-2 true-color chips.
CDSE_USERNAME=you@example.com
CDSE_PASSWORD=your-cdse-password

# Google Maps Platform API key (Places API + Static Maps API enabled).
# Used by research_tools/gmaps.py for delivery-pin search + site map image.
GMAPS_API_KEY=AIza-your-key-here
