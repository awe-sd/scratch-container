# local DB-pull cache -- regenerable, potentially large
archive/branch_tracking/data/raw/

# same-run diff copies (git history is the real archive)
archive/branch_tracking/output/*.prev

# python
__pycache__/
*.pyc
.venv/

# never commit real credentials (example.env is the safe template)
.env
*.env
!example.env
!archive/gis-research/example.env

# gis-research binaries live on S3 (sync_s3.py), not in git
archive/gis-research/research/*/sources/*.pdf
archive/gis-research/research/*/imagery/
archive/gis-research/research/*/imagery_grid/
archive/gis-research/research/*/run_stream*.jsonl
archive/gis-research/data/*.parquet
archive/gis-research/data/reference/puct_docket_pdfs/
archive/gis-research/data/reference/ch312_docs/
archive/gis-research/data/reference/county_minutes/
archive/gis-research/data/reference/*.xlsx
archive/gis-research/data/reference/search_cache/
!archive/gis-research/research/*/transcripts/*.jsonl.gz

# gis-research runtime-state files -- per-run/per-worker coordination state with no
# audit value (regenerated every run_agent.py/deep_worker.py invocation); run_meta_*.json
# is the audit trail and stays tracked
archive/gis-research/research/*/.budget_state.json
archive/gis-research/research/*/.budget_settings.json
archive/gis-research/research/*/.budget_warn_sent
archive/gis-research/research/*/.budget_exhaust_sent
archive/gis-research/research/*/.deep_claim
archive/gis-research/research/*/.deep_failed
archive/gis-research/research/*/.checkpoint_state.json

# binary safety net -- source/imagery dir naming has drifted beyond the patterns
# above (imagery_chips/, chips_grid/, img/, nested sources/*/*.pdf, root-level
# contact_sheet.png, sources/*.xlsx, sources/*.zip); catch these anywhere under
# gis-research/research regardless of location or extension case
archive/gis-research/research/**/*.pdf
archive/gis-research/research/**/*.PDF
archive/gis-research/research/**/*.png
archive/gis-research/research/**/*.jpg
archive/gis-research/research/**/*.jpeg
archive/gis-research/research/**/*.JPG
archive/gis-research/research/**/*.xlsx
archive/gis-research/research/**/*.zip
archive/gis-research/research/**/*.ZIP
archive/gis-research/research/**/*.parquet
archive/gis-research/research/**/*.doc
archive/gis-research/research/**/*.tmp.*
archive/gis-research/data/reference/*.parquet
